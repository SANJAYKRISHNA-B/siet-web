PORT=5050
CLIENT_URL=http://127.0.0.1:5173

# Telephony Mode: "mock" (default, 100% free ₹0 simulated testing) or "live"
# Mock mode is safe by default: 0 carrier charges, no API keys needed, zero real calls.
EXOTEL_CALL_MODE=mock
# TELEPHONY_MODE=mock (alias)

# Administrator Authentication Key (protects call logs, system status & retry controls)
ADMIN_API_KEY=siet-admin-2026

# Database Configuration (Optional: If omitted, server automatically uses local persistent SQLite with ₹0 setup)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=siet_app
# MYSQL_PASSWORD=change_this_password
# MYSQL_DATABASE=siet
# MYSQL_CONNECTION_LIMIT=10

# ==============================================================================
# Exotel Live Voice Telephony Configuration (ONLY active if EXOTEL_CALL_MODE=live)
# Official India Voice API Documentation: https://developer.exotel.com/docs/voice
# ==============================================================================

# Exotel Regional Cluster Base URL:
# Singapore Cluster (Default): https://api.exotel.com
# Mumbai / India Cluster: https://api.in.exotel.com
EXOTEL_API_BASE_URL=https://api.exotel.com
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_CALLER_ID=your_exotel_virtual_exophone_number

# RESTRICTED LIVE TEST NUMBER (CRITICAL SAFETY CONSTRAINT):
# In live mode, outbound calls are STRICTLY restricted to this 10-digit number.
# Public submissions can NEVER dial arbitrary numbers during testing.
EXOTEL_TEST_PHONE=9876543210
# EXOTEL_TEST_PHONE_NUMBER=9876543210 (alias)

# Call-Flow Configuration (One of these is required for live mode):
# Option A: Exotel Call Flow URL or App ID (plays official greeting)
# Official Greeting: "Thank you for your interest in Sri Shakthi Institute of Engineering and Technology. We have received your admission enquiry."
# EXOTEL_CALL_FLOW_URL=http://my.exotel.com/your_account_sid/exoml/start_voice/your_app_id
# EXOTEL_APP_ID=your_exotel_call_flow_app_id

# Option B: Direct staff counsellor mobile number (Connect Two Numbers)
EXOTEL_COUNSELLOR_NUMBER=919876543210

# Dialing Order for Connect Two Numbers:
# "student" (default): Exotel dials Student test phone first; once answered, dials Counsellor
# "counsellor": Exotel dials Counsellor first; once answered, dials Student
EXOTEL_DIAL_FIRST=student

# Status Callback Webhook (optional, receives terminal delivery events)
# EXOTEL_STATUS_CALLBACK_URL=https://your-domain.com/api/admission-enquiries/webhooks/exotel
# EXOTEL_WEBHOOK_TOKEN=your_optional_webhook_security_token

