{
  "name": "siet-mern",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sri Shakthi Institute MERN website",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "test": "npm run test:pages && npm test --workspace server",
    "test:pages": "node scripts/test_pages.mjs"
  },
  "devDependencies": {"concurrently":"8.2.2"}
}
